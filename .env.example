# ---------------------------------------------------------------------------
# Firebase (client SDK, all values are public by design)
# Credo only ever talks to Firestore from the browser, so these keys are safe
# to expose. Security comes from the Firestore rules in firestore.rules.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Optional. Only set this if you use a non default Firestore database id.
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=""

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Path the app is mounted on. Keep it as /credo so lowkey.tools/credo and
# credo.lowkey.tools serve identical asset URLs. Set to an empty string only if
# you want to run Credo at the root of its own domain.
NEXT_PUBLIC_BASE_PATH="/credo"

# Origin used when building share links and canonical tags. No trailing slash.
# Leave unset in local development to fall back to the browser origin.
NEXT_PUBLIC_SITE_ORIGIN="https://lowkey.tools"
