{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/credo"
    },
    {
      "source": "/:path((?!credo$|credo/).*)",
      "destination": "/credo/:path"
    }
  ]
}
